{
  "name": "realagy",
  "version": "2.0.0",
  "description": "Minimal Antigravity provider for pi: Gemini, Claude, and GPT models through the local agy CLI, with native pi tools and thinking.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "realagy",
    "antigravity",
    "agy",
    "agent-client-protocol",
    "gemini",
    "claude",
    "gpt",
    "provider"
  ],
  "license": "MIT",
  "author": {
    "name": "EstebanForge",
    "email": "esteban@attitude.cl",
    "url": "https://actitud.xyz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/st0nie/realagy.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "bun run build && bun run test",
    "smoke:pi": "pi -ne -e ./extensions --list-models antigravity",
    "smoke:live": "tsx scripts/smoke-acp.mts"
  },
  "files": [
    "extensions",
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "undici": "^8.12.4"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.9"
  }
}
