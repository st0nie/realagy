{
  "name": "@st0nie/pi-antigravity-bridge",
  "version": "1.9.2",
  "description": "Gemini provider for Pi on the Antigravity ACP server (official Google ACP) or the stream-json agy CLI. Use antigravity/* models in Pi. Full /model picker support. Models runs Pi's tools. ToS safe to use.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "antigravity",
    "antigravity-acp",
    "agy",
    "gemini",
    "google",
    "google-acp",
    "acp",
    "agent-client-protocol",
    "mcp",
    "mcp-server",
    "provider",
    "streaming"
  ],
  "license": "MIT",
  "author": {
    "name": "EstebanForge",
    "email": "esteban@attitude.cl",
    "url": "https://actitud.xyz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/st0nie/pi-antigravity-bridge.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "bun run typecheck && bun run test"
  },
  "files": [
    "extensions",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "dependencies": {
    "@estebanforge/pi-ask-shared": "^0.1.3",
    "@estebanforge/pi-tui-dialogs": "^0.1.2",
    "@modelcontextprotocol/sdk": "^1.31.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typebox": "^1.3.4",
    "typescript": "^5.8.0",
    "vitest": "^4.1.9",
    "yaml": "^2.9.0"
  }
}
